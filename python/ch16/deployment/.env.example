# Chapter 16: to copy as .env on the server, then to fill in. The .env file never goes into Git.

# The Comptoir's domain name, which points to this server (DNS A or AAAA record).
COMPTOIR_DOMAIN=comptoir.example.com
COMPTOIR_PUBLIC_URL=https://comptoir.example.com

# Output of “python -m ch16.authorization hash”, on your computer. Never the password itself.
COMPTOIR_PASSWORD_HASH=scrypt:16384:8:1:replace:me
