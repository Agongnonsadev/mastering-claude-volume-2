# Chapter 19: to copy as .env on the server, then to fill in (chmod 600 .env). The .env file never goes
# into Git, nor into the image: Docker reads it when the container starts.

# The Comptoir's domain name, which points to this server (DNS A or AAAA record).
COMPTOIR_DOMAIN=comptoir.example.com

# The key of the “comptoir-production” service account, in the production workspace (chapter 18).
ANTHROPIC_API_KEY=replace-me

# WhatsApp (Meta's App Dashboard): the app secret, the system user's token, and a
# verification string chosen by you, also entered in Meta's Verify token field.
COMPTOIR_WHATSAPP_APP_SECRET=replace-me
COMPTOIR_WHATSAPP_TOKEN=replace-me
COMPTOIR_WHATSAPP_VERIFY_TOKEN=replace-me

# Two random strings (for example: python -c "import secrets; print(secrets.token_hex(32))"):
# the salt of the numbers' fingerprints, and the dashboard's token (/dashboard).
COMPTOIR_PSEUDONYM_SALT=replace-me
COMPTOIR_DASHBOARD_TOKEN=replace-me

# The monitoring of chapter 18 (1 to turn it on, about $0.00005 per message).
COMPTOIR_MONITORING_FILTER=0
